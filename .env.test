# Test-runner environment. Loaded by tests/loadEnv.ts BEFORE .env, and any
# variable already present in the process environment wins over both — that is
# how CI points the suite at a disposable database.
NODE_ENV=test
DATABASE_URL=postgres://postgres:test@localhost:5433/sv_test
DATABASE_SSL=false
PAYLOAD_SECRET=test-only-secret-not-used-anywhere-else-0123456789abcdef
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_ORIGINS=http://localhost:3001
EMAIL_FROM_ADDRESS=test@sv.local
EMAIL_FROM_NAME=SV Developers (test)
SALES_NOTIFICATION_EMAIL=sales@example.test
LOG_LEVEL=error
CLOUDINARY_CLOUD_NAME=
SMTP_HOST=
PAYLOAD_SEED=false
