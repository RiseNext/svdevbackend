# Test-runner environment. Loaded by tests/loadEnv.ts BEFORE .env, and any
# variable already present in the process environment wins over both — that is
# how CI points the suite at a disposable database.
#
# 🔴 THIS FILE MUST DECLARE EVERY KEY IN THE SCHEMA, INCLUDING THE ONES WHOSE
# CORRECT TEST VALUE IS EMPTY. A key declared here is PINNED: `tests/loadEnv.ts`
# will not let the developer's personal `.env` reopen it. A key MISSING here is
# inherited from `.env`, and then the suite's behaviour depends on a file that
# is not in the repository.
#
# ⚠️ THAT IS NOT HYPOTHETICAL — IT BROKE THE SUITE. Only CLOUDINARY_CLOUD_NAME
# was declared. As soon as a developer put real Cloudinary credentials in their
# `.env`, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET leaked in beside the
# blank cloud name. That is a PARTIAL Cloudinary configuration, which the
# environment schema rejects on purpose, so every test file died with
# "Invalid environment. Refusing to boot." on a machine where the code was fine.
#
# The rule that follows: declare the whole group, never part of one. It also
# keeps real production secrets out of a process that only ever talks to
# disposable fixtures.
NODE_ENV=test
DATABASE_URL=postgres://postgres:test@localhost:5433/sv_test
DATABASE_SSL=false
PAYLOAD_SECRET=test-only-secret-not-used-anywhere-else-0123456789abcdef
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_ORIGINS=http://localhost:3001
LOG_LEVEL=error

# --- Cloudinary: ALL FOUR EMPTY = the local-disk path, which is what the suite
# tests. All-or-nothing; a partial set is a boot failure by design.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY_BASE_URL=

# --- Jobs + revalidation: empty so no test can fire a webhook at a real host.
CRON_SECRET=
ENABLE_JOB_WORKERS=false
REVALIDATE_WEBHOOK_URL=
REVALIDATE_SECRET=

DISABLE_LOGGING=false
PAYLOAD_SEED=false
