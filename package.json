{
  "name": "svbackend",
  "version": "1.0.0",
  "description": "SV Developers — Payload CMS 3 admin backend and public content API",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3001",
    "devsafe": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --port 3001",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" npm run generate:importmap && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3001",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "generate:types": "npm run payload -- generate:types",
    "generate:importmap": "npm run payload -- generate:importmap",
    "generate:db-schema": "npm run payload -- generate:db-schema",
    "migrate": "npm run payload -- migrate",
    "migrate:status": "npm run payload -- migrate:status",
    "migrate:create": "npm run payload -- migrate:create",
    "migrate:down": "npm run payload -- migrate:down",
    "seed": "npm run payload -- run src/seed/index.ts",
    "seed:rasterise": "npm run payload -- run src/seed/rasterise.ts",
    "jobs:run": "npm run payload -- jobs:run --queue default --limit 25",
    "jobs:loop": "npm run payload -- jobs:run --cron \"* * * * *\" --queue default --limit 25",
    "jobs:maintenance": "npm run payload -- jobs:run --cron \"*/15 * * * *\" --queue maintenance --handle-schedules",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest --config ./vitest.config.mts",
    "test:unit": "npm test -- tests/unit",
    "test:contract": "npm test -- tests/contract",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:drift": "npm run payload -- run src/scripts/checkAllDrift.ts",
    "check:cms": "npm run payload -- run src/scripts/verifyAdminCms.ts",
    "sandbox:reset": "docker compose down -v && docker compose up -d",
    "ci": "npm run migrate && npm run build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-nodemailer": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-cloud-storage": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "cloudinary": "2.7.0",
    "cross-env": "^7.0.3",
    "file-type": "^21.3.4",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.1",
    "pino": "^9.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "pino-pretty": "^11.3.0",
    "rimraf": "^6.0.1",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
