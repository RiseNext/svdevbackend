# =============================================================================
# .env.ci.example — SYNTACTICALLY VALID DUMMY VALUES for a BUILD-ONLY stage.
#
# WHY THIS FILE EXISTS:
# `next build` sets NODE_ENV=production, and the env schema's `superRefine`
# correctly requires the production variable set. A build stage that has no real
# secrets would therefore fail to boot the config — which is the guard WORKING,
# not a bug.
#
# 🔴 THE FIX IS DUMMY VALUES, NEVER A WEAKER SCHEMA.
# Specifically: NEVER add a SKIP_ENV_VALIDATION escape hatch. It will be set in
# production the first time a deploy is urgent, and then the empty-secret
# failure mode it was guarding against ships silently.
#
# In the real pipeline (deployment §20.13) the platform secret store supplies
# real values and this file is unnecessary. It exists for a local
# `npm run build` sanity check and for a build-only CI job.
#
#   cp .env.ci.example .env.ci
#   env $(grep -v '^#' .env.ci | xargs) npm run build
# =============================================================================

NODE_ENV=production
PAYLOAD_SECRET=ci-build-only-secret-0123456789abcdef0123456789abcdef
NEXT_PUBLIC_SERVER_URL=https://cms.example.invalid
CORS_ORIGINS=https://www.example.invalid
CSRF_ORIGINS=https://cms.example.invalid
DATABASE_URL=postgres://build:build@localhost:5432/build_only
DATABASE_SSL=true
CLOUDINARY_CLOUD_NAME=build-only
CLOUDINARY_API_KEY=build-only
CLOUDINARY_API_SECRET=build-only
REVALIDATE_WEBHOOK_URL=https://www.example.invalid/api/revalidate
REVALIDATE_SECRET=ci-build-only-revalidate
LOG_LEVEL=error
# No SMTP_*, EMAIL_* or SALES_NOTIFICATION_EMAIL: the email subsystem was
# removed. No PRIVACY_POLICY_URL: it was never read by anything but a 503 gate.
# No CRON_SECRET: it is optional in production and fails closed when absent.
