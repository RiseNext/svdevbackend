# =============================================================================
# svbackend/.env.example — copy to .env and fill in. NEVER commit .env
#
# Loaded by Next.js and by `payload run`. Do NOT add dotenv: Next loads env
# itself, and two loaders with different precedence rules produce a whole class
# of "works in the script, not in the app" bugs.
#
# PAYLOAD_CONFIG_PATH is set inside the `payload` npm script, not here.
# =============================================================================

NODE_ENV=development

# --- Payload core ------------------------------------------------------------
# Generate with: openssl rand -hex 32     (>= 32 chars; BOOT FAILS if shorter)
# Never the docs' `process.env.PAYLOAD_SECRET || ''` pattern — an empty secret
# yields a deterministic JWT signing key and a forgeable admin session.
PAYLOAD_SECRET=
# Protocol + domain (+ port) ONLY. A trailing path breaks password-reset links.
# 🔶 PRODUCTION: becomes https://cms.<final domain> — see
# docs/PRODUCTION-CONFIG.md §4, which lists every place the final domain is
# needed. The domain is deliberately not chosen yet (D-125).
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Comma-separated. svfrontend runs on 3000, svbackend on 3001. NEVER `*`.
# 🔶 PRODUCTION: the real site origin(s) — see docs/PRODUCTION-CONFIG.md §4.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_ORIGINS=http://localhost:3001

# --- Database ----------------------------------------------------------------
# NOT `DATABASE_URI` — that name does not appear anywhere in the Payload docs.
#
# LOCAL: the disposable Docker sandbox from docker-compose.yml, managed by
# Drizzle `push`. NEVER run `payload migrate` against it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sv_dev
DATABASE_SSL=false
#
# 🔶 PRODUCTION: Neon PostgreSQL (owner decision, 20 Sep 2026). Neon issues a
# connection string in this shape — take it from the Neon console, never from
# this file, and store it in the platform secret store:
#
#   DATABASE_URL=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
#   DATABASE_SSL=true      # REQUIRED in production; boot fails without it
#
# Use the DIRECT (non-pooled) endpoint for migrations and the POOLED endpoint
# for the running app. See docs/PRODUCTION-CONFIG.md §2 for why, and for the
# separate DDL-capable migrate role.
#
# =============================================================================
# 🔴 READ THIS BEFORE POINTING A LOCAL .env AT THE PRODUCTION NEON DATABASE.
#
# `npm run dev` WILL REWRITE THE SCHEMA OF WHATEVER DATABASE THIS POINTS AT.
#
# This is not a warning about a mistake you might make — it is what the tooling
# does by design. The Postgres adapter leaves Drizzle `push` at its default,
# which is ENABLED whenever NODE_ENV is not `production`, and push reconciles
# the database to the config by issuing DDL directly. That is correct and
# desirable for the disposable sandbox above. Against Neon it is a schema
# rewrite of production, performed by a dev server, with no migration recorded.
#
# ⚠️ IT WOULD NOT BE A NO-OP EVEN ON A CORRECTLY MIGRATED DATABASE. Migration
# 001 created `enum_payload_jobs_task_slug` with six labels and migration 004
# deliberately left the now-unused `sendLeadNotification` label in place,
# because Postgres has no `ALTER TYPE ... DROP VALUE`. Push wants four labels,
# so it would try to rebuild that type and rewrite `payload_jobs` to match.
# The measured, verified state of the production database is 51 tables with
# SIX labels on that enum; push disagrees with it on exactly that point.
#
# If you must run the application against production Neon — to verify a deploy,
# for instance — set PAYLOAD_MIGRATING=true in the process environment. The
# adapter checks that flag and skips push entirely, which is how `payload
# migrate` itself avoids this. `payload migrate` and `migrate:status` are always
# safe and never push.
#
#   PAYLOAD_MIGRATING=true npm run dev      # safe against Neon
#   npm run dev                             # sandbox ONLY
#
# PAYLOAD_MIGRATING is NOT part of the environment schema and must NOT be added
# to it: it is a per-command safety flag, not configuration, and a permanent
# value in a `.env` file would silently disable push for the sandbox too.
# =============================================================================

# --- Storage: Cloudinary -----------------------------------------------------
# Leave CLOUDINARY_CLOUD_NAME EMPTY for local development: the storage plugin is
# always registered but stays inert, and uploads fall back to local disk at
# ./media. Setting SOME but not all of the three below FAILS BOOT deliberately —
# a half-configured media store fails on the first upload, not at startup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OPTIONAL. Only for a Cloudinary private CDN distribution or a custom delivery
# hostname (Advanced plan and above). Defaults to
# https://res.cloudinary.com/<cloud name>. Protocol + host only, no path.
# Whatever host this resolves to MUST also appear in svfrontend's
# NEXT_PUBLIC_MEDIA_BASE_URL, or every next/image call site throws.
CLOUDINARY_DELIVERY_BASE_URL=

# --- Email -------------------------------------------------------------------
# 🔴 THERE ARE NO EMAIL VARIABLES, AND THIS IS NOT AN OMISSION.
#
# This product sends no email. An enquiry is stored in Postgres and read by the
# administrator in Admin -> Enquiries; the database IS the inbox. SMTP_HOST,
# SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, EMAIL_FROM_ADDRESS,
# EMAIL_FROM_NAME and SALES_NOTIFICATION_EMAIL were all REMOVED — production
# needs no mail credentials and boots without them.
#
# CONSEQUENCE: the Admin Panel's "Forgot password?" link cannot deliver.
# Recovery is `npm run admin:reset-password -- <email>`, or another
# administrator setting a new password in Admin -> Users. See RUNBOOK.md §7.

# --- Jobs & revalidation -----------------------------------------------------
# OPTIONAL EVERYWHERE, INCLUDING PRODUCTION. It guards only HTTP-triggered job
# runs, and jobs.access.run FAILS CLOSED without it — with no secret, an HTTP
# run is refused outright. The deployed workers run as local processes, not over
# HTTP, so leaving this EMPTY is the safer configuration. Set it only if you
# actually intend to trigger a run over HTTP (>= 32 chars).
CRON_SECRET=
# Only for the autoRun fallback — one process polling the `default` queue inside
# the API container instead of a separate worker service. With worker services
# deployed, leave FALSE: `true` on two instances runs every job twice.
ENABLE_JOB_WORKERS=false
# 🔶 PRODUCTION: https://<final site domain>/api/revalidate
# REQUIRED in production. Without it, publishing in the Admin Panel appears to
# work and the website silently never updates until its next ISR window.
REVALIDATE_WEBHOOK_URL=http://localhost:3000/api/revalidate
# Must be byte-identical to svfrontend's REVALIDATE_SECRET, or every
# revalidation is rejected with a 401 that only the job log sees (>= 16 chars).
REVALIDATE_SECRET=
LOG_LEVEL=debug
DISABLE_LOGGING=false

# --- Ops ---------------------------------------------------------------------
# Hard gate on src/seed/index.ts. MUST be false/unset in production — its
# absence IS the guard against seeding over live edits.
PAYLOAD_SEED=false

# --- Privacy policy ----------------------------------------------------------
# 🔴 NOT AN ENVIRONMENT VARIABLE. `PRIVACY_POLICY_URL` was REMOVED.
#
# It was read in exactly one place: a flag that made POST /api/v1/leads answer
# 503 in production. It was never rendered and never served to the frontend, so
# setting it proved nothing about whether a policy existed while leaving it unset
# disabled the only feature this website is for.
#
# The link a visitor actually follows is CMS DATA — Site Settings -> Legal ->
# legalLinks, rendered by the frontend Footer, editable without a redeploy. It
# is a launch CONTENT task, carried in docs/DEPLOYMENT-CHECKLIST.md.
