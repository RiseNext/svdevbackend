# =============================================================================
# svbackend/.env.example — copy to .env and fill in. NEVER commit .env
#
# Loaded by Next.js and by `payload run`. Do NOT add dotenv: Next loads env
# itself, and two loaders with different precedence rules produce a whole class
# of "works in the script, not in the app" bugs.
#
# PAYLOAD_CONFIG_PATH is set inside the `payload` npm script, not here.
# =============================================================================

NODE_ENV=development

# --- Payload core ------------------------------------------------------------
# Generate with: openssl rand -hex 32     (>= 32 chars; BOOT FAILS if shorter)
# Never the docs' `process.env.PAYLOAD_SECRET || ''` pattern — an empty secret
# yields a deterministic JWT signing key and a forgeable admin session.
PAYLOAD_SECRET=
# Protocol + domain (+ port) ONLY. A trailing path breaks password-reset links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Comma-separated. svfrontend runs on 3000, svbackend on 3001. NEVER `*`.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_ORIGINS=http://localhost:3001

# --- Database ----------------------------------------------------------------
# NOT `DATABASE_URI` — that name does not appear anywhere in the Payload docs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sv_dev
DATABASE_SSL=false

# --- Storage -----------------------------------------------------------------
# Leave S3_BUCKET EMPTY for local development: the s3Storage plugin is always
# registered but stays inert, and uploads fall back to local disk at ./media.
# To exercise the real S3 path locally: docker compose --profile s3 up -d
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT / S3_FORCE_PATH_STYLE are AWS-SDK pass-throughs that Payload's own
# docs never name. Required by MinIO and by most non-AWS providers.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Whatever host this resolves to MUST also appear in svfrontend's
# next.config.mjs images.remotePatterns, or every next/image call site throws.
CDN_BASE_URL=

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST EMPTY in dev: nodemailerAdapter() with no transport uses
# ethereal.email and prints preview credentials to the console. Nothing is
# delivered to a real inbox. In PRODUCTION an empty SMTP_HOST FAILS BOOT —
# because with no adapter Payload logs a warning and the send silently
# APPEARS TO SUCCEED, which is the one unacceptable failure mode here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=dev@sv.local
EMAIL_FROM_NAME=SV Developers (dev)
# 🔶 OWNER DECISION (OQ-2): the real sales inbox. Blocks production, not dev.
SALES_NOTIFICATION_EMAIL=sales@example.test

# --- Jobs & revalidation -----------------------------------------------------
# CRON_SECRET guards jobs.access.run for HTTP-triggered runs. Leave empty
# locally: an authenticated req.user satisfies the predicate.
CRON_SECRET=
# Only for the autoRun fallback. With worker containers, leave false.
# `true` on two instances produces DUPLICATE lead notifications.
ENABLE_JOB_WORKERS=false
REVALIDATE_WEBHOOK_URL=http://localhost:3000/api/revalidate
# Must be byte-identical to svfrontend's REVALIDATE_SECRET.
REVALIDATE_SECRET=
LOG_LEVEL=debug
DISABLE_LOGGING=false

# --- Ops ---------------------------------------------------------------------
# Hard gate on src/seed/index.ts. MUST be false/unset in production — its
# absence IS the guard against seeding over live edits.
PAYLOAD_SEED=false

# --- Compliance --------------------------------------------------------------
# 🔶 OWNER DECISION (OQ-24) — the largest compliance gap in the project.
# POST /api/v1/leads REFUSES submissions in production until this is a real,
# reachable URL. Collecting name + phone without a privacy policy is a DPDP
# Act exposure. The policy must name every sub-processor (email, storage).
PRIVACY_POLICY_URL=
